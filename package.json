{
  "name": "adis-portfolio",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node --env-file=.env scripts/generate-sitemap.js && node --env-file=.env scripts/get-snap-routes.js",
    "build": "node node_modules/vite/bin/vite.js build",
    "postbuild": "react-snap && node scripts/inject-canonicals.js",
    "preview": "vite preview",
    "vercel-build": "npm install && npm run prebuild && npm run build && npm run postbuild"
  },
  "reactSnap": {
    "source": "dist",
    "destination": "dist",
    "fallback": "index.html",
    "puppeteerArgs": [
      "--no-sandbox",
      "--disable-setuid-sandbox"
    ],
    "crawl": false,
    "include": [
      "/",
      "/hire",
      "/pricing",
      "/blog",
      "/uses",
      "/contents/projects",
      "/contents/projects/medibook",
      "/contents/projects/dalmatinske-vizure",
      "/contents/projects/korijen",
      "/contents/projects/travel-app",
      "/contents/projects/duolingo-clone",
      "/contents/projects/instagram-clone",
      "/blog/sta-je-landing-page",
      "/blog/zasto-je-tvoj-landing-page-spor-i-kako-to-popraviti",
      "/blog/5-gresaka-koje-ubijaju-konverzije",
      "/blog/roi-investicija-u-web-stranicu",
      "/blog/koliko-kosta-web-stranica-bih-2026",
      "/blog/profesionalna-email-adresa-firma",
      "/blog/5-znakova-treba-nova-web-stranica",
      "/blog/google-business-profil-besplatno",
      "/blog/wordpress-vs-custom-web-stranica-bih",
      "/blog/medibook-case-study-zakazivanje-termina-nextjs",
      "/blog/web-stranica-za-restoran-bih",
      "/blog/zasto-svaki-mali-biznis-treba-web-stranicu"
    ],
    "skipThirdPartyRequests": true,
    "headless": true,
    "viewport": {
      "width": 1440,
      "height": 900
    },
    "minifyHtml": false
  },
  "dependencies": {
    "@emailjs/browser": "^4.3.3",
    "@supabase/supabase-js": "^2.101.1",
    "marked": "^17.0.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "react-snap": "^1.23.0",
    "vite": "^5.4.2"
  }
}