{
  "name": "adis-portfolio",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node --env-file=.env scripts/generate-sitemap.js && node node_modules/vite/bin/vite.js build",
    "preview": "vite preview",
    "vercel-build": "npm install && npm run build",
    "postbuild": "react-snap"
  },
  "reactSnap": {
    "source": "dist",
    "destination": "dist",
    "puppeteerArgs": [
      "--no-sandbox",
      "--disable-setuid-sandbox"
    ],
    "puppeteerExecutablePath": "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe",
    "crawl": true,
    "include": [
      "/",
      "/hire",
      "/pricing",
      "/blog",
      "/uses",
      "/contents/projects",
      "/contents/projects/medibook",
      "/contents/projects/dalmatinske-vizure",
      "/contents/projects/korijen",
      "/contents/projects/travel-app",
      "/contents/projects/duolingo-clone",
      "/contents/projects/instagram-clone"
    ],
    "skipThirdPartyRequests": false,
    "headless": true,
    "viewport": {
      "width": 1440,
      "height": 900
    },
    "minifyHtml": {
      "collapseWhitespace": false,
      "removeComments": false
    }
  },
  "dependencies": {
    "@emailjs/browser": "^4.3.3",
    "@supabase/supabase-js": "^2.101.1",
    "marked": "^17.0.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "react-snap": "^1.23.0",
    "vite": "^5.4.2"
  }
}
